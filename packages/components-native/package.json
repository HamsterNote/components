{
  "name": "@hamster-note/components-native",
  "version": "0.1.0-beta.0",
  "description": "HamsterNote native foundation components for Expo SDK57, iOS and Android.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "dist-web",
    "README.md"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist-web/index.js",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "browser": "./dist-web/button.js",
      "react-native": "./dist/button.js",
      "import": "./dist/button.js",
      "default": "./dist/button.js"
    },
    "./icon": {
      "types": "./dist/icon.d.ts",
      "browser": "./dist-web/icon.js",
      "react-native": "./dist/icon.js",
      "import": "./dist/icon.js",
      "default": "./dist/icon.js"
    },
    "./popover": {
      "types": "./dist/popover.d.ts",
      "browser": "./dist-web/popover.js",
      "react-native": "./dist/popover.js",
      "import": "./dist/popover.js",
      "default": "./dist/popover.js"
    },
    "./menu": {
      "types": "./dist/menu.d.ts",
      "browser": "./dist-web/menu.js",
      "react-native": "./dist/menu.js",
      "import": "./dist/menu.js",
      "default": "./dist/menu.js"
    },
    "./text-field": {
      "types": "./dist/text-field.d.ts",
      "browser": "./dist-web/text-field.js",
      "react-native": "./dist/text-field.js",
      "import": "./dist/text-field.js",
      "default": "./dist/text-field.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "browser": "./dist-web/theme.js",
      "react-native": "./dist/theme.js",
      "import": "./dist/theme.js",
      "default": "./dist/theme.js"
    }
  },
  "scripts": {
    "build": "tsc --noEmit && tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=19.2.3 <19.3.0",
    "react-native": ">=0.86.3 <0.87.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-svg": "15.15.4",
    "tsup": "8.5.0",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0 || >=25.0.0"
  },
  "packageManager": "yarn@1.22.22"
}
